ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder

# Debian dash (/bin/sh) rejects pipefail; bench init logging relies on it.
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

# institute-lms is checked out in CI to .build/institute-lms (private repo).
COPY --chown=frappe:frappe .build/institute-lms /opt/frappe/institute-lms
COPY --chown=frappe:frappe images/layered/validate-apps-json.py /opt/frappe/validate-apps-json.py

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    echo "===== apps.json ====="; \
    cat /opt/frappe/apps.json; \
    echo "===== local app paths ====="; \
    python3 /opt/frappe/validate-apps-json.py /opt/frappe/apps.json; \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  else \
    echo "WARNING: apps.json missing or empty — installing Frappe only"; \
  fi && \
  bench init ${APP_INSTALL_ARGS} \
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench 2>&1 | tee /tmp/bench-init.log || { \
      echo "===== bench init failed — last 200 lines ====="; \
      tail -200 /tmp/bench-init.log; \
      echo "===== apps installed (if any) ====="; \
      ls -la /home/frappe/frappe-bench/apps 2>/dev/null || true; \
      exit 1; \
    } && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" -print0 | xargs -0r rm -rf

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# Required by AgriTheory Cloud Storage / python-magic
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libmagic1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
